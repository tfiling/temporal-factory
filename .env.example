# Copy to .env (gitignored) and fill in. Used by the worker container.
# No inline comments after values: Docker Compose rejects them.

# Claude auth: set ONE. If both are set, the API key may win and bill the API.
# CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# GitHub token with repo + issues access on the target repo
GH_TOKEN=

# Repo the factory works on (issues labeled `factory` become PRs)
TARGET_REPO=owner/repo

# Gate command, run in each job's worktree (default: bash /app/checks.sh)
# FACTORY_CHECKS_CMD=npm ci && node --check server.js
